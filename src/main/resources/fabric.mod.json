{
  "schemaVersion": 1,
  "id": "fractal",
  "version": "${version}",
  "name": "Fractal",
  "description": "Adds item subgroups.",
  "authors": [ "unascribed" ],
  "contact": {
    "repo": "https://github.com/DaFuqs/fractal"
  },
  "license": "MIT",
  "icon": "assets/fractal/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.dafuqs.fractal.Fractal"
    ]
  },
  "mixins": [
    "fractal.mixins.json"
  ],
  "accessWidener": "fractal.accesswidener",
  "depends": {
    "minecraft": ">=${minecraft_version}",
    "fabricloader": "*",
    "fabric-api": "*"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_1761": [
        "de/dafuqs/fractal/interfaces/ICreativeTabParent"
      ],
      "net/minecraft/class_481": [
        "de/dafuqs/fractal/interfaces/ISubTabLocation"
      ]
    },
    "modmenu": {
      "badges": [ "library" ]
    }
  }
}
