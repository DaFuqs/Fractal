{
  "schemaVersion": 1,
  "id": "fractal",
  "version": "${version}",
  "name": "Fractal",
  "description": "Adds item subgroups.",
  "authors": [
    "unascribed",
    "DaFuqs"
  ],
  "contact": {
    "website": "https://github.com/DaFuqs",
    "issues": "https://github.com/DaFuqs/fractal/issues",
    "repo": "https://github.com/DaFuqs/fractal"
  },
  "license": "MIT",
  "icon": "assets/fractal/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.dafuqs.fractal.Fractal"
    ]
  },
  "mixins": [
    "fractal.mixins.json"
  ],
  "accessWidener": "fractal.classtweaker",
  "depends": {
    "minecraft": ">=${minecraft_version}",
    "fabricloader": "*",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [ "library" ]
    }
  }
